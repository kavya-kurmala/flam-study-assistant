# Any OpenAI-compatible chat completions endpoint works here:
# OpenAI itself, OpenRouter, Groq, or a local Ollama server.
API_BASE_URL=https://api.openai.com/v1
API_KEY=sk-your-key-here
MODEL=gpt-4o-mini
PORT=3001

# --- Examples for other providers (uncomment one set) ---
#
# OpenRouter (free tier available):
# API_BASE_URL=https://openrouter.ai/api/v1
# MODEL=meta-llama/llama-3.1-8b-instruct:free
#
# Groq (free tier available):
# API_BASE_URL=https://api.groq.com/openai/v1
# MODEL=llama-3.1-70b-versatile
#
# Local Ollama (free, no key needed but the field is still required):
# API_BASE_URL=http://localhost:11434/v1
# MODEL=llama3.1
# API_KEY=ollama
